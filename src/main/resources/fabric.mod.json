{
	"schemaVersion": 1,
	"id": "foreversurvival",
	"version": "${version}",
	"name": "ForeverSurvival",
	"description": "A guided survival progression mod for Fabric Minecraft 26.2",
	"authors": [
		"ForeverSurvival"
	],
	"contact": {
		"homepage": "https://github.com/Bordder/foreversurvival",
		"sources": "https://github.com/Bordder/foreversurvival",
		"issues": "https://github.com/Bordder/foreversurvival/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.foreversurvival.ForeverSurvival"
		],
		"client": [
			"com.foreversurvival.client.ForeverSurvivalClient"
		]
	},
	"mixins": [
		"foreversurvival.mixins.json",
		{
			"config": "foreversurvival.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
